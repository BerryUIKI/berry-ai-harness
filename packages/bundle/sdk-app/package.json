{
  "name": "@berry-ai/harness-sdk-app",
  "description": "The dsh SDK profile bundle: stdio JSON-RPC serving and process lifecycle over dsh-base",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@berry-ai/harness-cmdline": "workspace:*",
    "@berry-ai/harness-sdk-jsonrpc-server": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@berry-ai/harness-skill-office": "workspace:*",
    "@berry-ai/harness-tool-workspace-dependencies": "workspace:*",
    "@berry-ai/harness-client-connection": "workspace:*",
    "@berry-ai/harness-client-file-upload": "workspace:*",
    "@berry-ai/harness-workspace": "workspace:*",
    "@berry-ai/harness-schedule": "workspace:*",
    "@berry-ai/harness-time-context": "workspace:*",
    "@berry-ai/harness-tool-schedule": "workspace:*",
    "@berry-ai/harness-tool-ask-user": "workspace:*",
    "@berry-ai/harness-tool-present": "workspace:*",
    "@berry-ai/harness-file-reference-local": "workspace:*",
    "@berry-ai/harness-deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
