{
  "name": "@deepseek-ai/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-agent-loop": "workspace:*",
    "@berry-ai/harness-deepseek-llm-api-extensions": "workspace:*",
    "@berry-ai/harness-jobs-local": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-llm-deepseek-api-key": "workspace:*",
    "@berry-ai/harness-llm-retry": "workspace:*",
    "@berry-ai/harness-mcp-resources": "workspace:*",
    "@berry-ai/harness-plugin-package-inventory-deepseek": "workspace:*",
    "@berry-ai/harness-sandbox-local": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "@deepseek-ai/dsh-sdk-app": "workspace:*",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-log-deepseek": "workspace:*",
    "@berry-ai/harness-session-persistence-jsonl": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-session-title": "workspace:*",
    "@berry-ai/harness-subprocess-local": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-terminal": "workspace:*",
    "@berry-ai/harness-terminal-bash": "workspace:*",
    "@berry-ai/harness-tool-bash-persistent": "workspace:*",
    "@berry-ai/harness-tool-pwsh-persistent": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-working-directory": "workspace:*",
    "@berry-ai/harness-tool-working-directory": "workspace:*",
    "@berry-ai/harness-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
