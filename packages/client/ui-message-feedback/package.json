{
  "name": "@berry-ai/harness-client-ui-message-feedback",
  "description": "The Web feedback surface: per-message Like/Dislike in the assistant-message action strip and the feedback dialog behind both ratings and /feedback, backed by the messageFeedback and sessionFeedback Host Remotes",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@berry-ai/harness-api-remotes",
        "@berry-ai/harness-client-locale",
        "@berry-ai/harness-client-ui-conversation",
        "@berry-ai/harness-client-ui-renderer",
        "@berry-ai/harness-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@berry-ai/harness-api-remotes": "workspace:*",
    "@berry-ai/harness-client-connection": "workspace:*",
    "@berry-ai/harness-client-locale": "workspace:*",
    "@berry-ai/harness-client-test-runtime": "workspace:*",
    "@berry-ai/harness-client-ui-conversation": "workspace:*",
    "@berry-ai/harness-client-ui-primitives": "workspace:*",
    "@berry-ai/harness-client-ui-renderer": "workspace:*",
    "@berry-ai/harness-client-ui-slots": "workspace:*",
    "@berry-ai/harness-message-feedback": "workspace:*",
    "@berry-ai/harness-remote-mock": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@berry-ai/harness-client-ui-chat": "workspace:*",
    "@berry-ai/harness-client-ui-session": "workspace:*",
    "@berry-ai/harness-client-ui-commands": "workspace:*",
    "@berry-ai/harness-command-feedback": "workspace:*",
    "@berry-ai/harness-client-store": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
