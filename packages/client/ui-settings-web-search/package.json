{
  "name": "@berry-ai/harness-client-ui-settings-web-search",
  "description": "Settings page for web search and fetch on the dsh web client's Plugins page: the Search and Fetch provider menus, the DeepSeek Search API result count, and legacy Messages search settings",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-web-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@berry-ai/harness-client-locale",
        "@berry-ai/harness-client-ui-settings",
        "@berry-ai/harness-client-ui-plugin-manager",
        "@berry-ai/harness-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-api-remotes": "workspace:*",
    "@berry-ai/harness-client-locale": "workspace:*",
    "@berry-ai/harness-client-store": "workspace:*",
    "@berry-ai/harness-client-test-runtime": "workspace:*",
    "@berry-ai/harness-client-ui-plugin-manager": "workspace:*",
    "@berry-ai/harness-client-ui-primitives": "workspace:*",
    "@berry-ai/harness-client-ui-renderer": "workspace:*",
    "@berry-ai/harness-client-ui-settings": "workspace:*",
    "@berry-ai/harness-client-ui-slots": "workspace:*",
    "@berry-ai/harness-web": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
