{
  "name": "@berry-ai/harness-terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerryUIKI/berry-ai-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-terminal": "workspace:*",
    "@berry-ai/harness-sandbox": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@berry-ai/harness-lazy-require": "workspace:*",
    "@berry-ai/harness-pwsh-local": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@berry-ai/harness-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@berry-ai/harness-terminal": "workspace:*",
    "@berry-ai/harness-sandbox": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@berry-ai/harness-subprocess-local": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-working-directory": "workspace:*"
  }
}
