{
  "name": "@berry-ai/harness-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@berry-ai/harness-brand": "workspace:*",
    "@berry-ai/harness-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-compaction": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-output-retention": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:*",
    "@berry-ai/harness-session-query": "workspace:*",
    "@deepseek-ai/dsh-session-title": "workspace:*",
    "@berry-ai/harness-spill": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@berry-ai/harness-spill": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-compaction": "workspace:*",
    "@berry-ai/harness-fs-local": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-output-retention": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:*",
    "@berry-ai/harness-session-query": "workspace:*",
    "@berry-ai/harness-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-session-title": "workspace:*",
    "@berry-ai/harness-spill": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@berry-ai/harness-spill-local": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-tool-fs": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*"
  }
}
