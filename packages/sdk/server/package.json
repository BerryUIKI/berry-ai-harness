{
  "name": "@berry-ai/harness-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@berry-ai/harness-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-attachment": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-llm-deepseek-api-key": "workspace:*",
    "@berry-ai/harness-schedule": "workspace:*",
    "@berry-ai/harness-scope": "workspace:*",
    "@berry-ai/harness-sdk-protocol": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-subagent": "workspace:*",
    "@berry-ai/harness-user-approval": "workspace:*",
    "@berry-ai/harness-user-questions": "workspace:*",
    "@berry-ai/harness-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-agent-loop": "workspace:*",
    "@berry-ai/harness-agent-loop-testkit": "workspace:*",
    "@berry-ai/harness-attachment": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-llm-deepseek-api-key": "workspace:*",
    "@berry-ai/harness-schedule": "workspace:*",
    "@berry-ai/harness-scope": "workspace:*",
    "@berry-ai/harness-sdk-protocol": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-persistence-jsonl": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-subagent": "workspace:*",
    "@berry-ai/harness-user-approval": "workspace:*",
    "@berry-ai/harness-user-questions": "workspace:*",
    "@berry-ai/harness-working-directory": "workspace:*"
  }
}
