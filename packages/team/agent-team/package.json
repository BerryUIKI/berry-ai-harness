{
  "name": "@berry-ai/harness-agent-team",
  "description": "Shared task DAG and change waits for subagent trees",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/team/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@berry-ai/harness-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-persistence": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-subagent": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-agent-loop": "workspace:*",
    "@berry-ai/harness-agent-loop-testkit": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-persistence": "workspace:*",
    "@berry-ai/harness-session-persistence-jsonl": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-session-query": "workspace:*",
    "@berry-ai/harness-subagent": "workspace:*",
    "@berry-ai/harness-subagent-fork-in-process": "workspace:*",
    "@berry-ai/harness-subagent-spawn-in-process": "workspace:*",
    "@berry-ai/harness-commands": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*"
  }
}
