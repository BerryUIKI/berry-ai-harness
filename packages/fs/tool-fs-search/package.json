    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-spill": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-timeout": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@berry-ai/harness-subprocess-local": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-output-retention": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-spill": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-timeout": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-scope": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*"
  }
