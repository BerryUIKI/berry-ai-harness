    "@berry-ai/harness-util-values": "workspace:*",
    "@berry-ai/harness-sandbox": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@berry-ai/harness-ptc-runtime": "workspace:*",
    "@berry-ai/harness-timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-util-values": "workspace:*",
    "@berry-ai/harness-sandbox": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "@berry-ai/harness-sandbox-local": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-session": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
