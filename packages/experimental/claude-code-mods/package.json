    "@berry-ai/harness-token-meter": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-typert-protocol": "workspace:*",
    "@berry-ai/harness-user-questions": "workspace:*",
    "@berry-ai/harness-working-directory": "workspace:*"
