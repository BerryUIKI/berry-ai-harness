{
  "name": "@berry-ai/harness-personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@berry-ai/harness-action-cards": "workspace:*",
    "@berry-ai/harness-client-ui-action-cards": "workspace:*",
    "@berry-ai/harness-creation-recommendations": "workspace:*",
    "@berry-ai/harness-client-ui-creation-recommendations": "workspace:*",
    "@berry-ai/harness-plugin-recommendations": "workspace:*",
    "@berry-ai/harness-client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-api-remote-access": "workspace:*",
    "@berry-ai/harness-app-boot": "workspace:*",
    "@berry-ai/harness-hmr": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-plugin-manager": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-skill": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-tool-executor-native": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
