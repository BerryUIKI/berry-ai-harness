{
  "name": "@berry-ai/harness-creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/creation-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-skill": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-plugin-manager": "workspace:*",
    "@berry-ai/harness-api-remote-access": "workspace:*",
    "@berry-ai/harness-subagent": "workspace:*",
    "@berry-ai/harness-app-boot": "workspace:*",
    "@berry-ai/harness-skill": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "@berry-ai/harness-tool-testkit": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "resolve.exports": "^2.0.3",
    "zod": "4.4.3",
    "@berry-ai/harness-client-ui-creation-recommendations": "workspace:*",
    "@berry-ai/harness-action-cards": "workspace:*",
    "@berry-ai/harness-client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg"
}
