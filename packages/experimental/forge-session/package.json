    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-working-directory": "workspace:*",
    "@berry-ai/harness-shell": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*"
  },
