    "@berry-ai/harness-shell-env": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-agent-loop": "workspace:*",
    "@berry-ai/harness-bash-local": "workspace:*",
    "@berry-ai/harness-experimental-forge": "workspace:*",
    "@berry-ai/harness-experimental-forge-github": "workspace:*",
    "@berry-ai/harness-fs-local": "workspace:*",
