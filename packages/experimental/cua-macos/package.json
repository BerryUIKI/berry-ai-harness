{
  "name": "@berry-ai/harness-experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.1-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-computer-use": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@berry-ai/harness-user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@berry-ai/harness-atomic-write": "workspace:*",
    "@berry-ai/harness-cua": "workspace:*"
  },
  "devDependencies": {
    "@berry-ai/harness-working-directory": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@berry-ai/harness-agent": "workspace:*",
    "@berry-ai/harness-agent-loop": "workspace:*",
    "@berry-ai/harness-agent-loop-testkit": "workspace:*",
    "@berry-ai/harness-attachment": "workspace:*",
    "@berry-ai/harness-attachment-local": "workspace:*",
    "@berry-ai/harness-computer-use": "workspace:*",
    "@berry-ai/harness-llm": "workspace:*",
    "@berry-ai/harness-session": "workspace:*",
    "@berry-ai/harness-session-projection": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-subprocess": "workspace:*",
    "@berry-ai/harness-subprocess-local": "workspace:*",
    "@berry-ai/harness-fs-local": "workspace:*",
    "@berry-ai/harness-llm-deepseek": "workspace:*",
    "@berry-ai/harness-ptc-runtime-node": "workspace:*",
    "@berry-ai/harness-sandbox-local": "workspace:*",
    "@berry-ai/harness-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@berry-ai/harness-ptc-runtime": "workspace:*",
    "@berry-ai/harness-user-questions": "workspace:*",
    "@berry-ai/harness-settings": "workspace:*",
    "@berry-ai/harness-app-boot": "workspace:*",
    "@berry-ai/harness-config-editor": "workspace:*",
    "@berry-ai/harness-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  }
}
