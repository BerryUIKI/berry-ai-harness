{
  "name": "@berry-ai/harness-mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mcp/mcp-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@berry-ai/harness-mcp-client": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-util-values": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@berry-ai/harness-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@berry-ai/harness-timeout": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@berry-ai/harness-credentials": "workspace:*",
    "@berry-ai/harness-mcp-client": "workspace:*",
    "@berry-ai/harness-settings": "workspace:*",
    "@berry-ai/harness-system-prompt": "workspace:*",
    "@berry-ai/harness-tools": "workspace:*",
    "@berry-ai/harness-util-values": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@berry-ai/harness-app-boot": "workspace:*",
    "@berry-ai/harness-config-editor": "workspace:*",
    "@berry-ai/harness-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@berry-ai/harness-typert-protocol": "workspace:*"
  }
}
